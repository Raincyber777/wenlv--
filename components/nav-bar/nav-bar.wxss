.nav-badge {
  position: absolute;
  top: -6rpx;
  right: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 9999rpx;
  background: linear-gradient(to right, #ef4444, #f87171);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-shadow: 0 2px 6px rgba(239, 68, 68, 0.3);
}

.nav-label {
  font-size: 22rpx;
  color: #9ca3af;
  font-weight: 500;
}

.nav-label-on {
  color: #059669;
  font-weight: 600;
}
