.page-product {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-tint) 0%, var(--bg) 15%);
}

/* 商品列表 */
.product-list {
  padding: 12rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.product-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.product-emoji-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.product-emoji {
  font-size: 56rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-400);
  margin-top: 4rpx;
}

.stock-zero {
  color: var(--red);
  font-weight: 500;
}

.product-price {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--red);
  margin-top: 4rpx;
}
