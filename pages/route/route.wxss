.page-route {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-tint) 0%, var(--bg) 15%);
}

/* 路线列表 */
.route-list {
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.route-card {
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.route-banner {
  position: relative;
  height: 192rpx;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  overflow: hidden;
}

.route-banner-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.3), transparent);
}

.route-banner-content {
  position: relative;
}

.route-title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.route-sub {
  display: block;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.route-body {
  padding: 24rpx;
}

.route-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.route-tag {
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: #f3f4f6;
  color: var(--text-600);
}

.route-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.route-meta-text {
  font-size: 24rpx;
  color: var(--text-400);
}

.route-meta-count {
  font-size: 24rpx;
  color: var(--brand-600);
  font-weight: 600;
}

.route-actions {
  display: flex;
  gap: 12rpx;
}

.route-btn-primary {
  flex: 1;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(to right, var(--brand-500), var(--teal));
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(16, 185, 129, 0.25);
}

.route-btn-ghost {
  flex: 1;
  height: 72rpx;
  border-radius: 24rpx;
  color: var(--text-600);
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
