.page-scenic {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-tint) 0%, var(--bg) 15%);
}

/* 景点列表 */
.scenic-list {
  padding: 12rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.scenic-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.scenic-emoji-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.scenic-emoji {
  font-size: 56rpx;
}

.scenic-info {
  flex: 1;
  min-width: 0;
}

.scenic-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.scenic-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
}

.scenic-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-400);
  margin-top: 6rpx;
}
