<view class="page-scenic">
  <!-- 顶部标题栏 -->
  <view class="page-header">
    <view class="header-bar bar-emerald"></view>
    <text class="header-title">景点管理</text>
    <view class="header-action" bindtap="onAdd">
      <text class="add-btn">+ 新增</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view
      wx:for="{{filters}}"
      wx:key="*this"
      class="filter-btn {{activeFilter === index ? 'filter-active' : 'filter-inactive'}}"
      data-index="{{index}}"
      bindtap="onFilterTap"
    >
      <text>{{item}}</text>
    </view>
  </scroll-view>

  <!-- 搜索 -->
  <view class="search-wrap">
    <t-search value="{{searchKey}}" placeholder="搜索景点名称 / 地址" shape="round" bind:change="onSearchChange" />
  </view>

  <!-- 景点列表 -->
  <view class="scenic-list">
    <view class="list-card glass scenic-item" wx:for="{{filteredList}}" wx:key="name">
      <view class="scenic-emoji-wrap" style="background:{{item.grad}}">
        <text class="scenic-emoji">{{item.emoji}}</text>
      </view>
      <view class="scenic-info">
        <view class="scenic-name-row">
          <text class="scenic-name">{{item.name}}</text>
          <text class="tag {{item.zone === '前山' ? 'tag-emerald' : 'tag-blue'}}">{{item.zone}}</text>
          <text class="tag {{item.status === 'open' ? 'tag-emerald' : 'tag-amber'}}">{{item.status === 'open' ? '开放' : '维护'}}</text>
        </view>
        <text class="scenic-desc">📍 {{item.dist}} · 🎙 语音 {{item.audio}}</text>
      </view>
      <view class="edit-btn" data-id="{{item.id || item.name}}" bindtap="onEdit">
        <text class="edit-text">编辑</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <t-empty wx:if="{{!filteredList.length}}" class="empty-wrap" description="没有找到相关景点" />

  <view class="bottom-space"></view>
  <nav-bar current="scenic"></nav-bar>
</view>
