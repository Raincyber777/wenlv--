.page-mine {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-tint) 0%, var(--bg) 20%);
}

/* 个人信息 */
.profile-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--brand-900) 0%, var(--brand-700) 45%, var(--brand-600) 75%, var(--brand-500) 100%);
  padding-top: calc(48rpx + env(safe-area-inset-top));
  padding-bottom: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.p-dc1 {
  width: 192rpx;
  height: 192rpx;
  background: rgba(255,255,255,0.05);
  top: -64rpx;
  right: -64rpx;
}

.p-dc2 {
  width: 128rpx;
  height: 128rpx;
  background: rgba(255,255,255,0.04);
  bottom: -40rpx;
  left: -40rpx;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 2px solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 72rpx;
}

.profile-name {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.role-badge {
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
}

/* 数据统计 */
.mine-stats {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  padding: 0 32rpx;
  margin-top: -32rpx;
}

.mine-stat {
  border-radius: 24rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  box-shadow: 0 10px 30px -12px rgba(16,185,129,0.12);
}

.mine-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand-600);
}

.mine-stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-400);
  margin-top: 8rpx;
}

/* 操作列表 */
.menu-card {
  margin: 24rpx 32rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.menu-item:first-child {
  border-top: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-900);
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-300);
  line-height: 1;
}
