.page-mine {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-tint) 0%, var(--bg) 20%);
}

/* 个人信息 */
.profile-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--brand-900) 0%, var(--brand-700) 45%, var(--brand-600) 75%, var(--brand-500) 100%);
  padding-top: calc(48rpx + env(safe-area-inset-top));
  padding-bottom: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.p-dc1 {
  width: 192rpx;
  height: 192rpx;
  background: rgba(255,255,255,0.05);
  top: -64rpx;
  right: -64rpx;
}

.p-dc2 {
  width: 128rpx;
  height: 128rpx;
  background: rgba(255,255,255,0.04);
  bottom: -40rpx;
  left: -40rpx;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 2px solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 72rpx;
}

.profile-name {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.role-badge {
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
}

/* 操作列表 */
.menu-card {
  margin: 24rpx 32rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
}
