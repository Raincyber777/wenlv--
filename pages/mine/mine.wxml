<view class="page-mine">
  <!-- 个人信息 -->
  <view class="profile-hero">
    <view class="deco-circle p-dc1"></view>
    <view class="deco-circle p-dc2"></view>
    <view class="avatar">
      <text class="avatar-emoji">👤</text>
    </view>
    <text class="profile-name">管理员</text>
    <view class="role-badge">
      <text>景区运营</text>
    </view>
  </view>

  <!-- 操作列表 -->
  <view class="menu-card">
    <t-cell-group>
      <t-cell
        wx:for="{{menus}}"
        wx:key="label"
        title="{{item.label}}"
        arrow
        hover
        t-class-title="menu-title"
        data-label="{{item.label}}"
        bind:click="onMenuTap"
      >
        <view slot="left-icon" class="menu-icon" style="background:{{item.grad}}">
          <text>{{item.icon}}</text>
        </view>
      </t-cell>
    </t-cell-group>
  </view>

  <view class="bottom-space"></view>
  <nav-bar current="mine"></nav-bar>
</view>

<!-- 退出登录弹窗 -->
<t-dialog
  visible="{{showLogout}}"
  title="退出登录"
  content="确定要退出当前账号吗？"
  confirm-btn="退出登录"
  cancel-btn="取消"
  bind:confirm="onLogoutConfirm"
  bind:cancel="onLogoutCancel"
  bind:close="onLogoutCancel"
/>
