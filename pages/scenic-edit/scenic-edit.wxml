<view class="page-edit">
  <!-- 顶部导航 -->
  <view class="edit-header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-arrow">‹</text>
    </view>
    <view class="header-bar bar-emerald"></view>
    <text class="header-title">{{isEdit ? '编辑景点' : '新增景点'}}</text>
    <view class="header-status" wx:if="{{isEdit}}">
      <text class="tag {{form.open ? 'tag-emerald' : 'tag-amber'}}">{{form.open ? '开放中' : '维护中'}}</text>
    </view>
  </view>

  <scroll-view class="edit-body" scroll-y>
    <!-- 地图卡片 -->
    <view class="card glass">
      <view class="card-head">
        <view class="card-bar bar-emerald"></view>
        <text class="card-title">景点位置</text>
        <text class="card-tip">地图选点 · 自动同步经纬度</text>
      </view>
      <map
        id="scenicMap"
        class="scenic-map"
        latitude="{{form.lat}}"
        longitude="{{form.lng}}"
        scale="{{scale}}"
        markers="{{markers}}"
        show-location
      />
      <view class="addr-row">
        <text class="addr-icon">📍</text>
        <text class="addr-text">{{form.address || '尚未设置地址，请点击下方选点'}}</text>
      </view>
      <view class="latlng-row">
        <view class="latlng-item">
          <text class="field-label">纬度 Lat</text>
          <input class="mini-input" type="digit" value="{{form.lat}}" data-field="lat" bindinput="onLatLngInput" />
        </view>
        <view class="latlng-item">
          <text class="field-label">经度 Lng</text>
          <input class="mini-input" type="digit" value="{{form.lng}}" data-field="lng" bindinput="onLatLngInput" />
        </view>
      </view>
      <view class="btn-row">
        <view class="btn-primary" bindtap="onChooseLocation">
          <text>📌 地图选点</text>
        </view>
        <view class="btn-ghost" bindtap="onOpenLocation">
          <text>导航预览 ›</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="card glass">
      <view class="card-head">
        <view class="card-bar bar-blue"></view>
        <text class="card-title">基本信息</text>
      </view>

      <view class="cover-preview" style="background:{{form.grad}}">
        <text class="cover-emoji">{{form.emoji}}</text>
        <view class="cover-text">
          <text class="cover-name">{{form.name || '景点名称预览'}}</text>
          <text class="cover-sub">{{form.zone}} · {{form.dist || '距离未填'}} · {{form.open ? '对外开放' : '暂停开放'}}</text>
        </view>
      </view>

      <view class="field">
        <text class="field-label">景点名称 <text class="req">*</text></text>
        <t-input value="{{form.name}}" placeholder="如：建福宫" maxlength="{{20}}" clearable="{{true}}" data-field="name" bind:change="onFieldInput" />
      </view>

      <view class="field-row">
        <view class="field flex-1">
          <text class="field-label">所属区域</text>
          <picker mode="selector" range="{{zones}}" value="{{form.zoneIndex}}" bindchange="onZoneChange">
            <view class="picker-box">
              <text>{{form.zone}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
        <view class="field flex-1">
          <text class="field-label">距山门距离</text>
          <t-input value="{{form.dist}}" placeholder="如：480m / 1.2km" clearable="{{true}}" data-field="dist" bind:change="onFieldInput" />
        </view>
      </view>

      <view class="field">
        <text class="field-label">详细地址 <text class="req">*</text></text>
        <t-input value="{{form.address}}" placeholder="如：青城山前山半山 · 天师洞" clearable="{{true}}" data-field="address" bind:change="onFieldInput" />
      </view>

      <view class="field">
        <text class="field-label">封面图标</text>
        <view class="emoji-grid">
          <view
            wx:for="{{emojis}}"
            wx:key="*this"
            class="emoji-item {{form.emoji === item ? 'emoji-active' : ''}}"
            data-emoji="{{item}}"
            bindtap="onEmojiTap"
          >
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">封面渐变</text>
        <view class="grad-grid">
          <view
            wx:for="{{grads}}"
            wx:key="label"
            class="grad-item {{form.gradIndex === index ? 'grad-active' : ''}}"
            style="background:{{item.value}}"
            data-index="{{index}}"
            bindtap="onGradTap"
          >
            <text wx:if="{{form.gradIndex === index}}" class="grad-check">✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 游玩推荐指数 -->
    <view class="card glass">
      <view class="card-head">
        <view class="card-bar bar-amber"></view>
        <text class="card-title">游玩推荐指数</text>
        <text class="score-badge">{{form.recommend}} 分</text>
      </view>
      <view class="star-row">
        <view
          wx:for="{{stars}}"
          wx:key="*this"
          class="star-btn"
          data-value="{{item}}"
          bindtap="onStarTap"
        >
          <text class="star {{item <= form.recommend ? 'star-on' : (item - 0.5 <= form.recommend ? 'star-half' : 'star-off')}}">{{item <= form.recommend ? '★' : (item - 0.5 <= form.recommend ? '★' : '☆')}}</text>
        </view>
        <text class="star-desc">{{form.recommend >= 4.5 ? '非常推荐' : form.recommend >= 4 ? '值得一游' : form.recommend >= 3 ? '顺路可去' : form.recommend > 0 ? '一般' : '暂无评分'}}</text>
      </view>
      <slider value="{{form.recommend}}" min="0" max="5" step="0.5" show-value activeColor="#10b981" bindchange="onRecommendSlider" />
      <text class="field-hint">支持 0.5 分微调，游客端将以星级展示</text>
    </view>

    <!-- 服务设施 -->
    <view class="card glass">
      <view class="card-head">
        <view class="card-bar bar-emerald"></view>
        <text class="card-title">服务设施</text>
      </view>

      <view class="facility-row">
        <view class="facility-left">
          <text class="facility-icon">🚻</text>
          <view class="facility-text">
            <text class="facility-name">卫生间 / 厕所</text>
            <text class="facility-sub">{{form.toilet ? '有 · 游客可见' : '无 · 游客端隐藏'}}</text>
          </view>
        </view>
        <t-switch value="{{form.toilet}}" data-field="toilet" bind:change="onSwitch" />
      </view>
      <view wx:if="{{form.toilet}}" class="field">
        <t-input value="{{form.toiletDesc}}" placeholder="如：洞口东侧公厕 · 含无障碍卫生间" clearable="{{true}}" data-field="toiletDesc" bind:change="onFieldInput" />
      </view>

      <view class="divider"></view>

      <view class="facility-row">
        <view class="facility-left">
          <text class="facility-icon">🍜</text>
          <view class="facility-text">
            <text class="facility-name">餐饮 / 吃食</text>
            <text class="facility-sub">{{form.food ? '有 · 游客可见' : '无 · 游客端隐藏'}}</text>
          </view>
        </view>
        <t-switch value="{{form.food}}" data-field="food" bind:change="onSwitch" />
      </view>
      <view wx:if="{{form.food}}" class="field">
        <t-input value="{{form.foodDesc}}" placeholder="如：道家素斋 / 盖碗茶 / 山间小卖部" clearable="{{true}}" data-field="foodDesc" bind:change="onFieldInput" />
      </view>
    </view>

    <!-- 介绍音频 -->
    <view class="card glass">
      <view class="card-head">
        <view class="card-bar bar-orange"></view>
        <text class="card-title">介绍音频</text>
        <text class="card-tip">游客端语音导览</text>
      </view>

      <view class="audio-player">
        <view class="audio-cover {{playing ? 'audio-playing' : ''}}">
          <text>{{playing ? '⏸' : '▶'}}</text>
        </view>
        <view class="audio-info" bindtap="togglePlay">
          <text class="audio-title">{{form.audioTitle || '未命名音频'}}</text>
          <text class="audio-sub">{{form.audioUrl ? (playing ? '正在试听…点击暂停' : '点击试听音频') : '暂无音频，请添加'}}</text>
        </view>
        <text wx:if="{{form.audioUrl}}" class="audio-clear" bindtap="onClearAudio">✕</text>
      </view>

      <view class="field">
        <text class="field-label">音频标题</text>
        <t-input value="{{form.audioTitle}}" placeholder="如：建福宫·道教宫观导览" clearable="{{true}}" data-field="audioTitle" bind:change="onFieldInput" />
      </view>
      <view class="field-row">
        <view class="field flex-1">
          <text class="field-label">音频时长</text>
          <t-input value="{{form.audio}}" placeholder="如：08:45" clearable="{{true}}" data-field="audio" bind:change="onFieldInput" />
        </view>
        <view class="field flex-1">
          <text class="field-label">快捷选音频</text>
          <view class="btn-ghost sm" bindtap="onChooseAudio">
            <text>🎙 选择音频</text>
          </view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">音频链接 / 本地路径</text>
        <t-input value="{{form.audioUrl}}" placeholder="https://…mp3 或选择本地音频" clearable="{{true}}" data-field="audioUrl" bind:change="onFieldInput" />
        <text class="field-hint" wx:if="{{audioTip}}">{{audioTip}}</text>
      </view>
    </view>

    <!-- 开放状态 -->
    <view class="card glass open-card {{form.open ? '' : 'closed'}}">
      <view class="facility-row">
        <view class="facility-left">
          <text class="facility-icon">{{form.open ? '🟢' : '🟡'}}</text>
          <view class="facility-text">
            <text class="facility-name">是否对外开放</text>
            <text class="facility-sub">{{form.open ? '开放中 · 游客端可预约游览' : '维护中 · 游客端显示暂停开放'}}</text>
          </view>
        </view>
        <t-switch value="{{form.open}}" data-field="open" bind:change="onSwitch" />
      </view>
    </view>

    <!-- 景点介绍 -->
    <view class="card glass">
      <view class="card-head">
        <view class="card-bar bar-blue"></view>
        <text class="card-title">景点介绍</text>
      </view>
      <t-textarea
        value="{{form.intro}}"
        placeholder="介绍景点的历史背景、看点、游玩建议，将同步展示到游客端…"
        maxlength="{{500}}"
        indicator="{{true}}"
        autosize="{{true}}"
        data-field="intro"
        bind:change="onFieldInput"
      />
    </view>

    <view class="bottom-pad"></view>
  </scroll-view>

  <!-- 底部操作 -->
  <view class="edit-footer">
    <view wx:if="{{isEdit}}" class="footer-del-wrap">
      <t-button theme="danger" variant="outline" size="large" block t-class="footer-del" bind:tap="onDelete">删除</t-button>
    </view>
    <view class="footer-save-wrap">
      <t-button theme="primary" size="large" block t-class="footer-save" bind:tap="onSave">{{isEdit ? '保存修改' : '确认新增'}}</t-button>
    </view>
  </view>
</view>

<!-- 删除确认弹窗 -->
<t-dialog
  visible="{{showDelete}}"
  title="删除景点"
  content="确定删除「{{form.name}}」吗？删除后游客端将不再展示。"
  confirm-btn="{{ { content: '删除', theme: 'danger' } }}"
  cancel-btn="取消"
  bind:confirm="onConfirmDelete"
  bind:cancel="onCancelDelete"
  bind:close="onCancelDelete"
/>
