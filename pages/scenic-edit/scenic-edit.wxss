.page-edit {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-tint) 0%, var(--bg) 18%);
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部导航 */
.edit-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx 16rpx;
  padding-top: calc(16px + env(safe-area-inset-top));
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(16, 185, 129, 0.1);
  flex-shrink: 0;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 44rpx;
  line-height: 1;
  color: var(--text-600);
  margin-top: -6rpx;
}

.header-status {
  margin-left: auto;
}

.edit-body {
  flex: 1;
  height: 0;
}

.card {
  margin: 16rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.card-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 9999rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
}

.card-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-400);
}

.score-badge {
  margin-left: auto;
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
  background: linear-gradient(to right, #fbbf24, #f97316);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

/* 地图 */
.scenic-map {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.addr-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #ecfdf5;
  border: 1px solid #d1fae5;
  border-radius: 16rpx;
}

.addr-icon {
  font-size: 28rpx;
}

.addr-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--brand-700);
  line-height: 1.5;
}

.latlng-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.latlng-item {
  flex: 1;
}

.btn-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.btn-primary {
  flex: 1.4;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(to right, var(--brand-500), var(--teal));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
}

.btn-ghost {
  flex: 1;
  height: 80rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1px solid #e5e7eb;
  color: var(--text-600);
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost.sm {
  height: 88rpx;
  font-size: 24rpx;
}

/* 基本信息 */
.cover-preview {
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.cover-emoji {
  font-size: 72rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cover-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.cover-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.field {
  margin-top: 16rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-row .flex-1 {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-600);
  margin-bottom: 8rpx;
}

.req {
  color: var(--red);
}

.text-input {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 88rpx;
  font-size: 26rpx;
  color: var(--text-900);
}

.text-input.mono {
  font-size: 22rpx;
  font-family: monospace;
}

.picker-box {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  height: 88rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-900);
}

.picker-arrow {
  color: var(--text-300);
  font-size: 32rpx;
}

.field-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-400);
  margin-top: 8rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.emoji-item {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.emoji-active {
  border-color: var(--brand-500);
  background: #ecfdf5;
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);
}

.grad-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.grad-item {
  width: 88rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.grad-active {
  border-color: #fff;
  box-shadow: 0 0 0 4rpx var(--brand-500);
}

.grad-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 推荐指数 */
.star-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.star-btn {
  padding: 8rpx;
}

.star {
  font-size: 56rpx;
  line-height: 1;
}

.star-on {
  color: #f59e0b;
}

.star-half {
  color: #fbbf24;
}

.star-off {
  color: #e5e7eb;
}

.star-desc {
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #d97706;
}

/* 设施 */
.facility-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.facility-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.facility-icon {
  font-size: 44rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.facility-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
}

.facility-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-400);
  margin-top: 2rpx;
}

.divider {
  height: 1px;
  background: #f3f4f6;
  margin: 20rpx 0;
}

/* 音频 */
.audio-player {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #fff7ed, #fef2f2);
  border: 1px solid #fed7aa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.audio-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fb923c, #ef4444);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
}

.audio-playing {
  animation: pulse-soft 1.2s ease-in-out infinite;
}

.audio-info {
  flex: 1;
  min-width: 0;
}

.audio-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-900);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-400);
  margin-top: 4rpx;
}

.audio-clear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fee2e2;
  color: #ef4444;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 开放状态 */
.open-card.closed {
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
  border-color: #fde68a;
}

.textarea {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-900);
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  line-height: 1.6;
}

.bottom-pad {
  height: 32rpx;
}

/* 底部操作 */
.edit-footer {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 1px solid rgba(16, 185, 129, 0.1);
}

.btn-danger {
  width: 180rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #ef4444;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-save {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(to right, var(--brand-500), var(--teal));
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
}
