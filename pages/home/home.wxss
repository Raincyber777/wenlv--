.page-home {
  min-height: 100vh;
}

/* 顶部渐变区 */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, #064e3b 0%, #047857 40%, #059669 70%, #10b981 100%);
  padding-top: calc(16px + env(safe-area-inset-top));
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.dc1 {
  width: 192rpx;
  height: 192rpx;
  background: rgba(255,255,255,0.05);
  top: -64rpx;
  right: -64rpx;
}

.dc2 {
  width: 128rpx;
  height: 128rpx;
  background: rgba(255,255,255,0.04);
  bottom: -40rpx;
  left: -40rpx;
}

.dc3 {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.06);
  top: 40rpx;
  right: 80rpx;
}

.hero-inner {
  position: relative;
  padding: 20rpx 40rpx 32rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 4rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border-radius: 9999rpx;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(16px);
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.9);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #34d399;
}

/* 核心数据卡片 */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.stat-card {
  border-radius: 24rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}

.stat-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.stat-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-emoji {
  font-size: 28rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.stat-trend {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 4rpx;
}

.trend-arrow {
  font-size: 20rpx;
}

.trend-arrow.up { color: #6ee7b7; }
.trend-arrow.down { color: #fca5a5; }

.trend-text {
  font-size: 22rpx;
}

.stat-sub {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 0;
}

.stat-sub-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.stat-sub-text {
  font-size: 22rpx;
  font-weight: 500;
}

.stat-note {
  display: block;
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 内容区背景 */
.content-bg {
  background: linear-gradient(180deg, #ecfdf5 0%, #f8fafc 20%);
}

/* 趋势卡片 */
.trend-card {
  margin: -12rpx 32rpx 0;
  position: relative;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10px 30px -12px rgba(16,185,129,0.05);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.card-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 9999rpx;
}

.bar-emerald { background: linear-gradient(to bottom, #34d399, #14b8a6); }
.bar-blue { background: linear-gradient(to bottom, #60a5fa, #6366f1); }

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.card-link {
  margin-left: auto;
  font-size: 24rpx;
  color: #059669;
  font-weight: 500;
}

/* 趋势图表 */
.trend-chart {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 224rpx;
  padding: 0 4rpx;
}

.trend-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.trend-bar {
  width: 100%;
  border-radius: 12rpx;
  background: linear-gradient(to top, #a7f3d0, #d1fae5);
  transform-origin: bottom;
}

.trend-bar.today {
  background: linear-gradient(to top, #10b981, #34d399);
  box-shadow: 0 2px 8px rgba(16,185,129,0.3);
}

.trend-day {
  font-size: 18rpx;
  color: #9ca3af;
}

.trend-day.today {
  color: #059669;
  font-weight: 600;
}

/* 实时动态 */
.feed-card {
  margin: 16rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10px 30px -12px rgba(16,185,129,0.05);
}

.feed-dot {
  margin-left: auto;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #34d399;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feed-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feed-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 1px 2px rgba(0,0,0,0.06);
}

.feed-text {
  flex: 1;
  font-size: 24rpx;
  color: #4b5563;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-time {
  font-size: 20rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.bottom-space {
  height: 160rpx;
}
