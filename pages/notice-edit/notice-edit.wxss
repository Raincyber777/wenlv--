.page-edit {
  min-height: 100vh;
  background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 18%);
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部导航 */
.edit-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx 16rpx;
  padding-top: calc(16px + env(safe-area-inset-top));
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(59, 130, 246, 0.12);
  flex-shrink: 0;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 44rpx;
  line-height: 1;
  color: var(--text-600);
  margin-top: -6rpx;
}

.header-status {
  margin-left: auto;
}

.edit-body {
  flex: 1;
  height: 0;
}

.card {
  margin: 16rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.card-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 9999rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
}

.card-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-400);
}

/* 预览 */
.preview-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.preview-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.preview-icon {
  font-size: 40rpx;
}

.preview-info {
  flex: 1;
  min-width: 0;
}

.preview-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ef4444;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(239, 68, 68, 0.3);
}

.preview-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.preview-type {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.type-emerald {
  background: #ecfdf5;
  color: #059669;
  border: 1px solid #d1fae5;
}

.type-blue {
  background: #eff6ff;
  color: #2563eb;
  border: 1px solid #dbeafe;
}

.preview-time {
  font-size: 22rpx;
  color: var(--text-400);
}

.preview-content {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border: 1px solid #f3f4f6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-600);
  line-height: 1.6;
}

/* 字段 */
.field {
  margin-top: 16rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-row .flex-1 {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-600);
  margin-bottom: 8rpx;
}

.req {
  color: var(--red);
}

.text-input {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 88rpx;
  font-size: 26rpx;
  color: var(--text-900);
}

.picker-box {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  height: 88rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-900);
}

.picker-arrow {
  color: var(--text-300);
  font-size: 32rpx;
}

.field-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-400);
  margin-top: 8rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.emoji-item {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.emoji-active {
  border-color: #3b82f6;
  background: #eff6ff;
  box-shadow: 0 2px 8px rgba(59, 130, 246, 0.25);
}

.grad-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.grad-item {
  width: 88rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.grad-active {
  border-color: #fff;
  box-shadow: 0 0 0 4rpx #3b82f6;
}

.grad-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 设施行 */
.facility-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.facility-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.facility-icon {
  font-size: 44rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.facility-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
}

.facility-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-400);
  margin-top: 2rpx;
}

.divider {
  height: 1px;
  background: #f3f4f6;
  margin: 20rpx 0;
}

.textarea {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-900);
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  line-height: 1.6;
}

.bottom-pad {
  height: 32rpx;
}

/* 底部操作 */
.edit-footer {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 1px solid rgba(59, 130, 246, 0.12);
}

.footer-save {
  height: 88rpx !important;
  background: linear-gradient(to right, #60a5fa, #4f46e5) !important;
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
}
