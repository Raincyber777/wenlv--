.page-edit {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffbeb 0%, #f8fafc 18%);
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部导航 */
.edit-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx 16rpx;
  padding-top: calc(16px + env(safe-area-inset-top));
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(245, 158, 11, 0.12);
  flex-shrink: 0;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 44rpx;
  line-height: 1;
  color: var(--text-600);
  margin-top: -6rpx;
}

.header-status {
  margin-left: auto;
}

.edit-body {
  flex: 1;
  height: 0;
}

.card {
  margin: 16rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.card-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 9999rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
}

.card-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-400);
}

/* 预览 */
.preview-wrap {
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-emoji {
  font-size: 72rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.preview-info {
  flex: 1;
  min-width: 0;
}

.preview-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.preview-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-tag {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: #fff7ed;
  color: #c2410c;
  flex-shrink: 0;
}

.preview-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.preview-price {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 4rpx;
}

.stock-warn {
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: #f0fdf4;
  color: var(--brand-600);
  font-size: 22rpx;
}

.stock-warn.warn-on {
  background: #fef2f2;
  color: #ef4444;
  font-weight: 600;
}

/* 字段 */
.field {
  margin-top: 16rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-row .flex-1 {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-600);
  margin-bottom: 8rpx;
}

.req {
  color: var(--red);
}

.text-input {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 88rpx;
  font-size: 26rpx;
  color: var(--text-900);
}

.picker-box {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  height: 88rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-900);
}

.picker-arrow {
  color: var(--text-300);
  font-size: 32rpx;
}

.field-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-400);
  margin-top: 8rpx;
}

.tag-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag-pick {
  padding: 12rpx 32rpx;
  border-radius: 9999rpx;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  font-size: 24rpx;
  color: var(--text-600);
}

.tag-pick-on {
  background: #fff7ed;
  border-color: #fb923c;
  color: #c2410c;
  font-weight: 600;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.emoji-item {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.emoji-active {
  border-color: #f59e0b;
  background: #fffbeb;
  box-shadow: 0 2px 8px rgba(245, 158, 11, 0.25);
}

.grad-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.grad-item {
  width: 88rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.grad-active {
  border-color: #fff;
  box-shadow: 0 0 0 4rpx #f59e0b;
}

.grad-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 上架状态 */
.shelf-card.off {
  background: #fef2f2;
  border-color: #fecaca;
}

.facility-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.facility-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.facility-icon {
  font-size: 44rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.facility-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
}

.facility-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-400);
  margin-top: 2rpx;
}

.textarea {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-900);
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  line-height: 1.6;
}

.bottom-pad {
  height: 32rpx;
}

/* 底部操作 */
.edit-footer {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 1px solid rgba(245, 158, 11, 0.12);
}

.footer-save {
  height: 88rpx !important;
  background: linear-gradient(to right, #fbbf24, #f97316) !important;
  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
}
