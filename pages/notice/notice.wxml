<view class="page-notice">
  <!-- 顶部标题栏 -->
  <view class="page-header">
    <view class="header-bar bar-blue"></view>
    <text class="header-title">消息公告</text>
    <view class="header-action" bindtap="onPublish">
      <text class="add-btn">+ 发布</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view
      wx:for="{{filters}}"
      wx:key="*this"
      class="filter-btn {{activeFilter === index ? 'filter-active' : 'filter-inactive'}}"
      data-index="{{index}}"
      bindtap="onFilterTap"
    >
      <text>{{item}}</text>
    </view>
  </scroll-view>

  <!-- 消息列表 -->
  <view class="notice-list">
    <view class="list-card glass notice-item" wx:for="{{filteredList}}" wx:key="title">
      <view class="notice-icon-wrap" style="background:{{item.grad}}">
        <text class="notice-icon">{{item.icon}}</text>
      </view>
      <view class="notice-info">
        <view class="notice-title-row">
          <text class="notice-title">{{item.title}}</text>
          <view wx:if="{{item.unread}}" class="unread-dot"></view>
        </view>
        <view class="notice-meta">
          <text class="notice-type {{item.type === '公告' ? 'type-emerald' : 'type-blue'}}">{{item.type}}</text>
          <text class="notice-time">{{item.time}}</text>
        </view>
      </view>
      <view class="edit-btn" data-id="{{item.id || item.title}}" bindtap="onEdit">
        <text class="edit-text">编辑</text>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
  <nav-bar current="notice"></nav-bar>
</view>
