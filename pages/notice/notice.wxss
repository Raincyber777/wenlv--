.page-notice {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-tint) 0%, var(--bg) 15%);
}

/* 消息列表 */
.notice-list {
  padding: 12rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.notice-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.notice-icon {
  font-size: 40rpx;
}

.notice-info {
  flex: 1;
  min-width: 0;
}

.notice-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-900);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--red);
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(239, 68, 68, 0.3);
}

.notice-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.notice-type {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.type-emerald {
  background: #ecfdf5;
  color: var(--brand-600);
  border: 1px solid #d1fae5;
}

.type-blue {
  background: #eff6ff;
  color: #2563eb;
  border: 1px solid #dbeafe;
}

.notice-time {
  font-size: 22rpx;
  color: var(--text-400);
}
